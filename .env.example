# IronLedger local development (copy to .env — never commit secrets)
DATABASE_URL=postgres://ironledger:ironledger@127.0.0.1:5432/ironledger
KAFKA_BROKERS=127.0.0.1:19092
KAFKA_TOPIC_LEDGER_EVENTS=ledger.events
KAFKA_TOPIC_DEAD_LETTER=ledger.events.dlq
HTTP_LISTEN=0.0.0.0:8080
GRPC_LISTEN=0.0.0.0:50051
RUST_LOG=info,ironledger=debug
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
IRONLEDGER_AUTH_MODE=dev
# Dev-only bearer; rotate in any shared environment
IRONLEDGER_DEV_TOKEN=dev-only-change-me
